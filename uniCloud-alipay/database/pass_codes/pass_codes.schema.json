{
  "bsonType": "object",
  "required": ["code", "level"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": { "description": "ID，系统自动生成" },
    "code": { "bsonType": "string", "description": "通行证号码" },
    "level": { "bsonType": "string", "description": "对应的通行证等级：normal/high/unlimited" },
    "enabled": { "bsonType": "bool", "description": "是否启用该激活码" }
  }
}
