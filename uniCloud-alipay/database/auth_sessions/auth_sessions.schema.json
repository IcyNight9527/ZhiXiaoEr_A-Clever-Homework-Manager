{
	"bsonType": "object",
	"required": [
		"token_hash",
		"user_id",
		"created_at",
		"expires_at"
	],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "会话ID，系统自动生成"
		},
		"token_hash": {
			"bsonType": "string",
			"description": "登录凭证的SHA-256哈希，不保存凭证明文"
		},
		"user_id": {
			"bsonType": "string",
			"description": "对应users集合中的userId"
		},
		"created_at": {
			"bsonType": "double",
			"description": "创建时间，毫秒时间戳"
		},
		"expires_at": {
			"bsonType": "double",
			"description": "过期时间，毫秒时间戳"
		}
	}
}
